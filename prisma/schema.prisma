generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductCategory {
  DECORATIVE
  RESIDENTIAL
  COMMERCIAL
  SAFETY
}

enum PricingType {
  PER_SQFT
  FIXED
}

model Product {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  categories    ProductCategory[] @default([])
  description   String
  pricingType   PricingType       @default(PER_SQFT)
  pricePerSqft  Decimal?          @db.Decimal(10, 2)
  fixedPrice    Decimal?          @db.Decimal(10, 2)
  fixedSize     String? // e.g. "24 x 24"
  isFeatured    Boolean           @default(false)
  isActive      Boolean           @default(true)
  metaTitle     String?
  metaDesc      String?
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  images        ProductImage[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  ProductCategory?
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  city      String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model Settings {
  id             String @id @default("settings")
  whatsappNumber String @default("923015025862")
  ownerEmail     String @default("mudassirchadhar789@gmail.com")
}
